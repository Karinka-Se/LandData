<Window x:Class="LandData.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оценка земельных участков" Height="600" Width="1000"
        MinHeight="400" MinWidth="700">

    <Window.Resources>
        <!-- Перенос длинного текста в ячейках таблицы -->
        <Style x:Key="WrapText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: поиск и список регионов -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Padding="4"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <ListBox ItemsSource="{Binding Regions}"
                     SelectedItem="{Binding SelectedRegion}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Code}" Width="30" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая часть: карточка региона -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,8" Text="{Binding SelectedRegion.Name}"/>
            <DataGrid ItemsSource="{Binding SelectedRegion.Rules}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Вид" Width="200"
                        Binding="{Binding CategoryName}"
                        ElementStyle="{StaticResource WrapText}"/>
                    <DataGridTextColumn Header="Значение" Width="*"
                        Binding="{Binding ValueText}"
                        ElementStyle="{StaticResource WrapText}"/>
                    <DataGridTextColumn Header="Комментарий" Width="*"
                        Binding="{Binding Comment}"
                        ElementStyle="{StaticResource WrapText}"/>
                    <DataGridTextColumn Header="Редакция от" Width="100"
                        Binding="{Binding EditionDate, StringFormat=dd.MM.yyyy}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>